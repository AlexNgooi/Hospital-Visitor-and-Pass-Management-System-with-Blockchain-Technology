# Optional Compose MySQL; native MySQL remains on port 3306.
# Passwords below are placeholders for configuration validation only.
# Before starting containers, copy this file to local .env and replace them.
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=hsaas_db
MYSQL_USER=hsaas
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
