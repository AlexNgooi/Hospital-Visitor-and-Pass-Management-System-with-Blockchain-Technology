        "properties" : {
          "timestamp" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "UTC ISO timestamp."
          },
          "status" : {
            "type" : "integer",
            "minimum" : 400,
            "maximum" : 599
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "correlationId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "fieldErrors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          },
          "details" : {
            "$ref" : "#/components/schemas/RestartDetails"
          }
        },
        "description" : "Uniform security/filter/controller error. details is omitted except the typed restart code.",
        "allOf" : [ {
          "if" : {
            "required" : [ "details" ]
          },
          "then" : {
            "properties" : {
              "code" : {
                "const" : "REGISTRATION_ENTRY_RESTART_REQUIRED"
              }
            }
          }
        } ]
      },
      "ExchangeRequest" : {
        "required" : [ "entryToken" ],
        "properties" : {
          "entryToken" : {
            "type" : "string",
            "maxLength" : 2048
          },
          "expectedFormContext" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/FormContext"
            }, {
              "type" : "null"
            } ]
