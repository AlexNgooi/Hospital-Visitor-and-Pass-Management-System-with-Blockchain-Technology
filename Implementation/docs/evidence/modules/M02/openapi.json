        "properties" : {
          "field" : {
            "type" : "string"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "description" : "Safe field diagnostics without rejectedValue."
      },
      "FormContext" : {
        "required" : [ "grantReference", "bindingVersion" ],
        "properties" : {
          "bindingVersion" : {
            "maximum" : 9007199254740991,
            "minimum" : 0,
            "type" : "integer"
          },
          "grantReference" : {
            "type" : "string",
            "maxLength" : 128,
            "pattern" : "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "additionalProperties" : false,
        "type" : "object"
      },
      "RestartDetails" : {
