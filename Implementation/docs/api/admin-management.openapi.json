{
  "openapi": "3.1.0",
  "info": {
    "title": "HSAAS administration redesign increment",
    "version": "2026-11-16",
    "description": "Current authorized increment for codex/admin-management-redesign. Supplements the frozen foundation mirror; does not claim complete application OpenAPI coverage. ADMIN does not inherit counter staff authority. All writes use same-origin CSRF. Visitor management is excluded."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/auth/me": {
      "get": {
        "summary": "Current session; passwordChangeRequired restricts all business APIs until the initial password is replaced.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result; SMTP acceptance is not confirmed inbox delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentMe"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Expired, revoked or absent session"
          },
          "403": {
            "description": "Role denied or password change required"
          },
          "409": {
            "description": "Version conflict, duplicate login/email, last ready administrator protection, email configuration missing or pending send"
          },
          "422": {
            "description": "The complete export exceeds the row or byte limit"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "Replace an unexpired initial password, revoke old sessions and require a new sign-in. Passwords allow paste and are limited to 72 UTF-8 bytes.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result; SMTP acceptance is not confirmed inbox delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Expired, revoked or absent session"
          },
          "403": {
            "description": "Role denied or password change required"
          },
          "409": {
            "description": "Version conflict, duplicate login/email, last ready administrator protection, email configuration missing or pending send"
          },
          "422": {
            "description": "The complete export exceeds the row or byte limit"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeInitialPassword"
              }
            }
          }
        }
      }
    },
