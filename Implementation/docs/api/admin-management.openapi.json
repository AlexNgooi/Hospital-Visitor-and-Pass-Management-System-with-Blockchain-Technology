  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "HSAAS_SESSION",
        "description": "HttpOnly host-only SameSite=Lax browser-session cookie; Secure by default. Managed by browser, never used as an explicit caller scope."
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "Saved": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "saved": {
            "const": true
          }
        },
        "required": [
          "saved"
        ]
      },
      "CreateStaff": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
          },
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "COUNTER_STAFF"
            ]
          }
        },
        "required": [
          "login",
          "fullName",
          "email",
          "role"
        ]
      },
      "EditStaff": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "COUNTER_STAFF"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "fullName": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "version",
          "role",
          "active"
        ]
      },
      "Staff": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "login": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "COUNTER_STAFF"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "passwordChangeRequired": {
            "type": "boolean"
          },
          "onboardingDelivery": {
            "type": "string",
            "enum": [
              "NOT_REQUIRED",
              "PENDING",
              "ACCEPTED",
              "UNKNOWN"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "counterId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "active": {
                  "type": "boolean"
                },
                "version": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740990
                }
              },
              "required": [
                "counterId",
                "active",
                "version"
              ]
            }
          }
        },
        "required": [
          "id",
          "login",
          "role",
          "active",
          "version",
          "fullName",
          "email",
          "passwordChangeRequired",
          "onboardingDelivery",
          "permissions"
        ]
      },
      "EmailReadiness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configured": {
            "type": "boolean"
          }
        },
        "required": [
          "configured"
        ]
      },
      "Delivery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "saved": {
            "const": true
          },
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "emailStatus": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "saved",
          "id",
          "emailStatus"
        ]
      },
      "ResendInitial": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          }
        },
        "required": [
          "version"
        ]
      },
      "ChangeInitialPassword": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 72
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72
          }
        },
        "required": [
          "currentPassword",
          "newPassword",
          "confirmPassword"
        ]
      },
      "ChartRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "snapshotUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "snapshotUpdatedAt"
        ]
      },
      "ChartReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "recordedAt"
        ]
      },
      "Export": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "csv": {
            "type": "string"
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "serverUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "filename",
          "csv",
          "rowCount",
          "serverUpdatedAt"
        ]
      },
      "InventorySummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "AVAILABLE": {
            "type": "integer",
            "minimum": 0
          },
          "ISSUED": {
            "type": "integer",
            "minimum": 0
          },
          "OVERDUE": {
            "type": "integer",
            "minimum": 0
          },
          "LOST": {
            "type": "integer",
            "minimum": 0
          },
          "DISABLED": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "AVAILABLE",
          "ISSUED",
          "OVERDUE",
          "LOST",
          "DISABLED"
        ]
      },
      "CurrentMe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "login",
          "role",
          "counterIds",
          "passwordChangeRequired"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Server database ID serialized as a decimal string."
          },
          "login": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "COUNTER_STAFF"
            ]
          },
          "counterIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "Server database ID serialized as a decimal string."
            },
            "uniqueItems": true,
            "description": "Current active staff counter grants; ADMIN has an empty list."
          },
          "passwordChangeRequired": {
            "type": "boolean"
          }
        },
        "description": "Minimal current authenticated staff projection."
      },
      "InventoryCard": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cardCode": {
            "type": "string"
          },
          "maskedUid": {
            "type": [
              "string",
              "null"
            ]
          },
          "categoryCode": {
            "type": "string",
            "enum": [
              "EXECUTIVE",
              "PENJAGA",
              "VENDOR",
              "CONTRACTOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "ISSUED",
              "OVERDUE",
              "LOST",
              "DISABLED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          },
          "source": {
            "type": "string",
