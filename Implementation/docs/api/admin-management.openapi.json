{
  "openapi": "3.1.0",
  "info": {
    "title": "HSAAS administration redesign increment",
    "version": "2026-11-24",
    "description": "Current authorized increment for codex/admin-management-redesign. Supplements the frozen foundation mirror; does not claim complete application OpenAPI coverage. ADMIN does not inherit counter staff authority. All writes use same-origin CSRF. Visitor management is excluded. V11 adds Ward/Other destinations, unbound manual stock, registration-scoped loans and explicitly audited visitor-name report views/exports. Dynamic visitor-type/field management remains excluded. V12 removes counter records and uses an account-level staff access setting."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
