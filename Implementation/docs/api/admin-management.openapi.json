    },
    "/api/admin/cards": {
      "get": {
        "summary": "Search complete authorized inventory; summary counts ignore the status filter but honor search/category/destination.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result; SMTP acceptance is not confirmed inbox delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Expired, revoked or absent session"
          },
          "403": {
            "description": "Role denied or password change required"
          },
          "409": {
            "description": "Version conflict, duplicate login/email, last ready administrator protection, email configuration missing or pending send"
          },
          "422": {
            "description": "The complete export exceeds the row or byte limit"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "EXECUTIVE",
                "PENJAGA",
                "VENDOR",
                "CONTRACTOR"
              ]
            }
          },
          {
            "name": "destination",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "AVAILABLE",
                "ISSUED",
                "OVERDUE",
                "LOST",
                "DISABLED"
              ]
            }
          }
        ]
      }
    },
    "/api/admin/reports/compiled-exports": {
      "post": {
        "summary": "Audit and export all matching registration/pass/metric rows in one formula-safe masked CSV, or reject without a partial download. Maximum 10,000 total rows and bounded 1 MiB JSON. Read-committed queries do not reconstruct historical as-of state.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result; SMTP acceptance is not confirmed inbox delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Expired, revoked or absent session"
          },
          "403": {
            "description": "Role denied or password change required"
          },
          "409": {
            "description": "Version conflict, duplicate login/email, last ready administrator protection, email configuration missing or pending send"
          },
          "422": {
            "description": "The complete export exceeds the row or byte limit"
          }
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          {
            "name": "destinationId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        }
      }
    },
    "/api/admin/reports/chart-exports": {
      "post": {
        "summary": "Audit filters and the captured snapshot timestamp before a browser-only PNG download; no chart pixels are uploaded.",
        "security": [
