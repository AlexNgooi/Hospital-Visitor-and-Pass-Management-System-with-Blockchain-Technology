  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "HSAAS_SESSION",
        "description": "HttpOnly host-only SameSite=Lax browser-session cookie; Secure by default. Managed by browser, never used as an explicit caller scope."
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "Saved": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "saved": {
            "const": true
          }
        },
        "required": [
          "saved"
        ]
      },
      "CreateStaff": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
          },
